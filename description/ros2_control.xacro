<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <ros2_control name="GazeboSystem" type="system">
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>

        <joint name="base_to_roue_arriere_gauche">
            <command_interface name="velocity">
                <param name="min">-10</param>
                <param name="max">10</param>
            </command_interface>
           <state_interface name="position"/>
           <state_interface name="velocity"/>
        </joint>
        <joint name="base_to_roue_arriere_droite">
           <command_interface name="velocity">
                <param name="min">-10</param>
                <param name="max">10</param>
           </command_interface>
           <state_interface name="position"/>
           <state_interface name="velocity"/>
        </joint>
    </ros2_control>

    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <!-- Chemin vers votre fichier de configuration YAML des contrôleurs -->
        <parameters>$(find lemower_package)/config/my_controllers.yaml</parameters>
      </plugin>
    </gazebo>
</robot>
